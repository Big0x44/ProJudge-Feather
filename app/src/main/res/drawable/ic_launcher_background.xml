<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Red Background (entire canvas to avoid seams) -->
    <path android:pathData="M 0,0 H 108 V 108 H 0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:color="#E53935" android:offset="0.0" />
                <item android:color="#B71C1C" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Blue Background (bottom-right half overlay) -->
    <path android:pathData="M 108,0 L 108,108 L 0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="108"
                android:startY="0"
                android:endX="0"
                android:endY="108"
                android:type="linear">
                <item android:color="#1E88E5" android:offset="0.0" />
                <item android:color="#0D47A1" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
